# ============================================================
# LorIAx : variables d'environnement
# Pour une installation Docker : bash scripts/generate-env.sh > .env
# (génère tous les secrets). Ce fichier liste les variables lues
# par l'application. [REQUIRED] = obligatoire, [OPTIONAL] = facultatif.
# ============================================================

# ============================================================
# Base de données [REQUIRED]
# ============================================================
# PostgreSQL 16 avec pgvector, pg_trgm et pgcrypto. Dans Docker Compose,
# l'hôte est le nom du service : postgres.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://loriax:CHANGER_LE_MOT_DE_PASSE@postgres:5432/loriax

# ============================================================
# Authentification [REQUIRED]
# ============================================================
# URL publique de l'application (redirections, e-mails, QR codes)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret de signature des sessions, 16 caractères minimum.
# Laissé vide volontairement : une valeur d'exemple partagée permettrait de
# forger des sessions. Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
# Domaine partagé entre sous-domaines pour le cookie de session (ex: .exemple.fr)
# NEXTAUTH_COOKIE_DOMAIN=

# Clé d'installation de l'assistant /setup. Absente, l'application en génère une
# au premier affichage et l'écrit dans les journaux du conteneur.
# Générer avec : openssl rand -hex 24
# SETUP_BOOTSTRAP_TOKEN=

# ============================================================
# Chiffrement [REQUIRED]
# ============================================================
# Clé de 32 octets en base64. Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=

# ============================================================
# Tâches planifiées [REQUIRED en production]
# ============================================================
# Secret des appels aux routes /api/cron (en-tête Authorization: Bearer <secret>).
# Sans lui, ces routes refusent tout appel. Générer avec : openssl rand -hex 32
CRON_SECRET=

# ============================================================
# Serveur [OPTIONAL]
# ============================================================
# Nombre de reverse proxies de confiance devant l'application (défaut : 1)
# TRUSTED_PROXY_COUNT=1

# ============================================================
# Stockage objet S3 : Garage [REQUIRED]
# ============================================================
S3_ENDPOINT=garage
S3_PORT=3900
# Garage : GK + 24 caractères hexadécimaux (GK$(openssl rand -hex 12))
S3_ACCESS_KEY=
# 64 caractères hexadécimaux (openssl rand -hex 32)
S3_SECRET_KEY=
S3_BUCKET=loriax-files
S3_REGION=garage
# true quand le stockage est servi en HTTPS
S3_USE_SSL=false
# URL publique du stockage et du WebSocket, pour la CSP en production
# S3_PUBLIC_URL=https://s3.exemple.fr
# WS_URL=wss://wiki.exemple.fr

# ============================================================
# Documents [OPTIONAL]
# ============================================================
WORKSPACES_PATH=/app/workspaces

# ============================================================
# IA : fournisseurs [OPTIONAL]
# ============================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# Ollama (modèles locaux) : docker compose --profile ollama up -d
OLLAMA_BASE_URL=http://ollama:11434
# Fournisseur et modèle par défaut : claude | openai | ollama | mistral
DEFAULT_AI_PROVIDER=ollama
DEFAULT_AI_MODEL=gemma4:e4b

# Embeddings (recherche sémantique)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ============================================================
# Calendrier CalDAV [OPTIONAL]
# ============================================================
CALDAV_ENABLED=false
# CALDAV_BASE_URL=http://localhost:5232

# ============================================================
# Webhooks sortants [OPTIONAL]
# ============================================================
# Autoriser les webhooks vers un service du réseau privé (ex: http://n8n:5678)
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ============================================================
# Redis : limitation de débit partagée entre instances [OPTIONAL]
# ============================================================
# REDIS_URL=redis://localhost:6379

# ============================================================
# Visioconférence LiveKit [OPTIONAL]
# ============================================================
# Service fourni par docker-compose.livekit.yml :
#   docker compose -f docker-compose.yml -f docker-compose.livekit.yml up -d
LIVEKIT_ENABLED=false
# URL WebSocket publique du serveur LiveKit, jointe depuis le navigateur
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dossier des enregistrements audio (volume partagé avec Egress)
# LIVEKIT_EGRESS_PATH=/recordings

# ============================================================
# Transcription des réunions [OPTIONAL, requiert LiveKit]
# ============================================================
WHISPER_ENABLED=false
# WHISPER_API_URL=http://whisper:8000
# WHISPER_MODEL=Systran/faster-whisper-medium
# WHISPER_LANGUAGE=fr
# WHISPER_DIARIZE=false
# Voxtral (STT Mistral, GPU NVIDIA de 16 Go minimum) : profil Docker "voxtral"
# Voxtral est desactive par defaut : cette valeur remplace le defaut de l'application.
# Passer a true seulement avec le profil Docker "voxtral" (GPU NVIDIA).
VOXTRAL_ENABLED=false
# VOXTRAL_API_URL=http://voxtral:9001
# VOXTRAL_MODEL=mistralai/Voxtral-Mini-Latest
# VOXTRAL_LANGUAGE=fr
# Moteur actif : whisper (CPU) ou voxtral (GPU)
# TRANSCRIPTION_ENGINE=whisper
# TRANSCRIPTION_VOCABULARY=
